diff -ruN a/src/OpenFOAM/fields/Fields/symmTensorField/symmTensorField.C b/src/OpenFOAM/fields/Fields/symmTensorField/symmTensorField.C
--- a/src/OpenFOAM/fields/Fields/symmTensorField/symmTensorField.C	2026-10-14 00:59:32.327194222 -0300
+++ b/src/OpenFOAM/fields/Fields/symmTensorField/symmTensorField.C	2026-10-14 00:59:32.426914037 -0300
@@ -53,6 +53,16 @@
 
 void inv(Field<symmTensor>& tf, const UList<symmTensor>& tf1)
 {
+    // OA2IS fix: TFOR_* loops use __restrict__ pointers; when called in place
+    // (tmp reuse, tf and tf1 share storage) GCC >= 13 -O3 produces wrong
+    // inverses (off-diagonal tensors). Work on a copy when aliased.
+    if (!tf.empty() && static_cast<const void*>(tf.cdata()) == static_cast<const void*>(tf1.cdata()))
+    {
+        const Field<symmTensor> tf1Copy(tf1);
+        inv(tf, tf1Copy);
+        return;
+    }
+
     if (tf.empty())
     {
         return;
