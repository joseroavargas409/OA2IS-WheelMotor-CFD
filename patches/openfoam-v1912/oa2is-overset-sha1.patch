+        //- Put single character.
+        //  OA2IS patch: libstdc++ from GCC >= 13 sends single characters
+        //  through overflow(); the std::streambuf default returns EOF, which
+        //  sets badbit and aborts every functionObject digest.
+        virtual int overflow(int c = EOF)
+        {
+            if (c != EOF)
+            {
+                const char ch = char(c);
+                sha1_.append(&ch, 1);
+            }
+            return (c == EOF) ? 0 : c;
+        }
